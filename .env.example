# Local runs only. In GitHub, add these as repository secrets (Settings -> Secrets and variables -> Actions).
GOLDAPI_KEY=                 # live prices provider key (goldapi.io)
ANTHROPIC_API_KEY=           # daily news + outlook
CLAUDE_MODEL=                # optional, default claude-opus-5-5
SUPABASE_URL=                # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=        # the SECRET key (formerly service_role): SERVER-SIDE ONLY, never put it in site/ or commit it
