{
  "name": "gold-tracker-india",
  "version": "1.0.0",
  "private": true,
  "description": "Gold & silver rates for India with history, news-aware 3-day outlook, buy/sell meters and a private purchase tracker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "prices": "node scripts/fetch-live.mjs",
    "prices:dry": "node scripts/fetch-live.mjs --dry-run",
    "outlook": "node scripts/update-outlook.mjs",
    "outlook:dry": "node scripts/update-outlook.mjs --dry-run",
    "backfill": "node scripts/backfill-history.mjs",
    "import": "node scripts/import-csv.mjs",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
