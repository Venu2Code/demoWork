{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run validate)", "Bash(npm run serve)", "Bash(npm run update:dry)", "Bash(node scripts/*)", "Bash(git status)", "Bash(git diff*)", "Bash(git log*)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(rm -rf /*)", "Bash(git push --force*)", "Bash(git push -f*)"]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }] }],
    "PreToolUse": [
      { "matcher": "WebFetch|Bash", "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/guard-web.py" }] },
      { "matcher": "Write|Edit|Bash|Read", "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.py" }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/post-validate.py" }] }
    ]
  }
}
